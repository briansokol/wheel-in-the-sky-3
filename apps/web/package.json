{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:with-sentry": "cross-env WITH_SENTRY=true npm run build",
    "check-types": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "deploy": "wrangler deploy",
    "dev": "vite --host",
